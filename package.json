{
  "name": "@local/dsh-knowledge-base",
  "version": "2.4.13",
  "description": "个人知识工作台：可控隐私、首次设置、目录地图、快速收集、阅读摘录、引用问答与按需备份。",
  "icon": "./src/client/capture-icon.svg",
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./package.json": "./package.json",
    "./client": "./src/client/index.js",
    "./core": "./packages/kb-core/index.js",
    "./contracts": "./packages/kb-contracts/index.js",
    "./service": "./packages/kb-service/index.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "PARSING-PREVIEW.md",
    "WORKBENCH.md",
    "BETA4.md",
    "browser-extension",
    "presets",
    "skills",
    "tools/kb-pdf-pages.py",
    "tools/kb-local-model.py",
    "tools/kb-transactional-update.py",
    "BETA7.md",
    "BETA8.md",
    "BETA9.md",
    "VERSIONING.md",
    "PROJECT-RECORD.md",
    "RETRIEVAL.md",
    "PERFORMANCE.md",
    "RELEASE.md",
    "RELEASE.en.md",
    "PROJECT-RECORD.en.md",
    "WORKBENCH.en.md",
    "VERSIONING.en.md",
    "EXISTING-FRAMEWORK-OPTIMIZATION.md",
    "packages/kb-core",
    "packages/kb-contracts",
    "packages/kb-service",
    "runtime/python",
    "docs",
    "ARCHITECTURE.md",
    "ARCHITECTURE.en.md",
    "DEVELOPMENT.md",
    "DEVELOPMENT.en.md",
    "MONOREPO.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/01-knowledge-agent.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "private": true
}
