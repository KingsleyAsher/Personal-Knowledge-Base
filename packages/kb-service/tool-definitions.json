  {
    "name": "kb_record",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "create 或 update"
        },
        "kind": {
          "type": "string",
          "description": "知识 / 项目 / 人物 / 素材 / 画像（create 必填）"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "正文（Markdown）"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "description": "派生自哪份原件（库内相对路径）"
        },
        "entryId": {
          "type": "string",
          "description": "update 必填"
        },
        "expectedRevision": {
          "type": "string",
          "description": "update 必填，非空"
        },
        "patch": {
          "type": "object",
          "additionalProperties": true,
          "description": "update 的字段级修改"
        },
        "requestId": {
          "type": "string",
          "description": "幂等请求标识（可选）：网络/中断后重试请传同一个值，重试不会重复建条目；用户主动再建请换新值"
        }
      },
      "required": [
        "action"
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "entryId": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "conflict": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    }
  },
